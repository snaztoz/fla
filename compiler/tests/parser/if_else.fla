fun basic_if() do
  if 1 + 1 == 5 do
    5
  end
end

fun basic_if_else() do
  if foo do
  else do
  end
end

fun multiple_if_else_branches() do
  if foo do
    50
  else if 2 > 5 and bar do
    100
  else do
    150
  end
end

fun if_else_expression() do
  var dynamic = if a == 5 do
    true
  else do
    false
  end
end
